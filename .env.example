# -- ollama vm instance (optional, run `ollama launch openclaw` inside VM) ---
OLLAMA_VM_BASE_IMAGE=openclaw-ollama-vm-base:local
OLLAMA_VM_IMAGE=openclaw-ollama-vm:local
OLLAMA_VM_PORT=11434
OLLAMA_VM_OPENCLAW_PORT=18794
OLLAMA_VM_OPENCLAW_GATEWAY_PORT=18789
OLLAMA_VM_OPENCLAW_GATEWAY_BIND=lan
OLLAMA_VM_OPENCLAW_GATEWAY_TOKEN=
OLLAMA_VM_OPENCLAW_ALLOWED_ORIGINS=http://127.0.0.1:18794,http://localhost:18794
OLLAMA_VM_OPENCLAW_MODEL=openai/gpt-oss-20b
OLLAMA_VM_MODEL_PROVIDER=lmstudio
OLLAMA_VM_MODEL_API=openai-completions
OLLAMA_VM_OLLAMA_BASE_URL=http://host.docker.internal:1234
OLLAMA_VM_AUTO_PULL_MODEL=0
OLLAMA_VM_SKIP_BOOTSTRAP=1
OLLAMA_VM_DISABLE_TOOLS=1
OLLAMA_VM_OPENCLAW_STATE_DIR=/vm/.openclaw
OLLAMA_VM_OPENCLAW_WORKSPACE_DIR=/vm/workspace
OLLAMA_VM_OPENCLAW_HOME=/vm/.openclaw
OLLAMA_VM_OPENCLAW_CONFIG_PATH=/vm/.openclaw/openclaw.json
OLLAMA_VM_OLLAMA_MODELS=/vm/.ollama/models
OLLAMA_VM_START_OPENCLAW=1
OLLAMA_VM_QMD_AUTO_SETUP=1
OLLAMA_VM_QMD_AUTO_EMBED=1
OLLAMA_VM_BROWSER_CDP_URL=http://browser-ollama:9222
OLLAMA_VM_BROWSER_DEFAULT_PROFILE=openclaw-ollama
OLLAMA_VM_BROWSER_EVALUATE_ENABLED=true
TELEGRAM_BOT_TOKEN_OLLAMA=
TELEGRAM_DM_POLICY_OLLAMA=allowlist
TELEGRAM_ALLOW_FROM_OLLAMA=
TELEGRAM_GROUP_POLICY_OLLAMA=allowlist
TELEGRAM_GROUP_ALLOW_FROM_OLLAMA=
TELEGRAM_REPLY_TO_MODE_OLLAMA=all
TELEGRAM_CHUNK_MODE_OLLAMA=newline
TELEGRAM_TEXT_CHUNK_LIMIT_OLLAMA=3500
TELEGRAM_STREAM_MODE_OLLAMA=block
TELEGRAM_LINK_PREVIEW_OLLAMA=false
TELEGRAM_MEDIA_MAX_MB_OLLAMA=10
TELEGRAM_REACTION_NOTIFICATIONS_OLLAMA=own
TELEGRAM_REACTION_LEVEL_OLLAMA=minimal
TELEGRAM_INLINE_BUTTONS_OLLAMA=allowlist
TELEGRAM_ACTIONS_REACTIONS_OLLAMA=true
TELEGRAM_ACTIONS_STICKER_OLLAMA=false
TELEGRAM_WEBHOOK_URL_OLLAMA=
TELEGRAM_WEBHOOK_SECRET_OLLAMA=
TELEGRAM_WEBHOOK_PATH_OLLAMA=/telegram-webhook
TELEGRAM_MESSAGE_PREFIX_OLLAMA=
OLLAMA_VM_MEMORY_TIMEZONE=UTC
OLLAMA_VM_MEMORY_SYNC_INTERVAL_SECONDS=300
OLLAMA_VM_MEMORY_AGENTS=main

# -- mission control (common kanban dashboard) --------------------------------
MISSION_CONTROL_PORT=8099

# ── Port ─────────────────────────────────────────────────────────────────────
PORT=8080

# ── Coolify-specific (auto-set by Coolify) ───────────────────────────────────
# COOLIFY_FQDN         — public FQDN assigned by Coolify
# COOLIFY_URL          — Coolify dashboard URL
# COOLIFY_BRANCH       — git branch deployed
